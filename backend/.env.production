# Production Environment Variables Template
# Copy this to your Render dashboard > Environment Variables

# ============================================
# REQUIRED: Security
# ============================================
# Generate a strong random key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-production-secret-key-change-this

# ============================================
# REQUIRED: Database
# ============================================
# Render will auto-inject this from the database service
# Format: mysql+pymysql://username:password@host:port/database
DATABASE_URL=${DATABASE_URL}

# ============================================
# REQUIRED: Server Configuration
# ============================================
PORT=10000
FLASK_ENV=production

# ============================================
# OPTIONAL: CORS (Update after frontend deployment)
# ============================================
# Add your Vercel frontend URL here after deployment
# Example: FRONTEND_URL=https://ccisched.vercel.app
FRONTEND_URL=https://your-frontend-url.vercel.app

# ============================================
# OPTIONAL: Email Notifications (if implemented)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@ccisched.com

# ============================================
# OPTIONAL: Additional Settings
# ============================================
# MAX_CONTENT_LENGTH=16777216  # 16MB file upload limit
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=None
